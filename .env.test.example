PORT=3333
HOST=localhost
LOG_LEVEL=info
APP_KEY=changeme_generate_with_node_ace_generate_key
NODE_ENV=test

# Database configuration for tests
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=boulder_test

# Session
SESSION_DRIVER=cookie

# Mail (fake mailer is enabled automatically in tests - no real emails sent)
# Brevo API key not required for tests
BREVO_API_KEY=fake_key_for_tests

# Google OAuth (optional for tests)
GOOGLE_CLIENT_ID=fake_google_id
GOOGLE_CLIENT_SECRET=fake_google_secret
GOOGLE_CALLBACK_URL=http://localhost:3333/auth/google/callback
