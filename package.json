{
  "name": "boulder-problem-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "start": "dotenv -e .env node build/server.js",
    "build": "node ace build --ignore-ts-errors",
    "dev": "node ace serve --watch",
    "dev-ext": "PORT=3334 node ace serve --watch",
    "test": "node ace test",
    "test:watch": "node ace test --watch",
    "test:functional": "node ace test functional",
    "test:unit": "node ace test unit",
    "db:test:setup": "NODE_ENV=test node ace migration:run",
    "db:test:reset": "NODE_ENV=test node ace migration:rollback && NODE_ENV=test node ace migration:run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#events/*": "./app/events/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#database/*": "./database/*.js",
    "#start/*": "./start/*.js",
    "#tests/*": "./tests/*.js",
    "#config/*": "./config/*.js"
  },
  "devDependencies": {
    "@adonisjs/eslint-config": "^1.2.1",
    "@adonisjs/prettier-config": "^1.2.1",
    "@adonisjs/tsconfig": "^1.2.1",
    "@japa/api-client": "^2.0.2",
    "@japa/assert": "^2.1.0",
    "@japa/plugin-adonisjs": "^3.0.0",
    "@japa/runner": "^3.1.1",
    "@swc/wasm": "^1.4.2",
    "@types/luxon": "^3.4.2",
    "@types/node": "^20.11.10",
    "eslint": "^8.56.0",
    "pino-pretty": "^10.3.1",
    "prettier": "^3.2.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@adonisjs/ally": "^5.1.0",
    "@adonisjs/assembler": "^7.1.1",
    "@adonisjs/auth": "^9.1.1",
    "@adonisjs/core": "^6.2.2",
    "@adonisjs/cors": "^2.2.1",
    "@adonisjs/lucid": "^20.1.0",
    "@adonisjs/mail": "^9.2.0",
    "@adonisjs/session": "^7.1.1",
    "@getbrevo/brevo": "^3.0.1",
    "@vinejs/vine": "^3.0.1",
    "adonis-autoswagger": "^3.73.0",
    "axios": "^1.7.9",
    "better-sqlite3": "^9.4.1",
    "dotenv-cli": "^8.0.0",
    "edge-iconify": "^2.0.1",
    "edge.js": "^6.0.1",
    "firebase-admin": "^13.6.0",
    "knex-postgis": "^0.14.3",
    "libsodium-wrappers-sumo": "^0.7.15",
    "luxon": "^3.4.4",
    "node-fetch": "^3.3.2",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.2.1",
    "sharp": "^0.34.3",
    "socket.io": "^4.8.1",
    "xml2js": "^0.6.2"
  },
  "eslintConfig": {
    "extends": "@adonisjs/eslint-config/app"
  },
  "prettier": "@adonisjs/prettier-config"
}
